<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>org.pollymc.PollyMC</id>
  <name>PollyMC</name>
  <summary>Custom Minecraft Launcher to easily manage multiple Minecraft installations at once</summary>
  <developer id="org.prismlauncher">
    <name>PollyMC Contributors</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>PollyMC is a custom launcher for Minecraft that focuses on freedom, modpack automation, and simplicity.</p>
    <p>Features:</p>
    <ul>
      <li>Easily install mod frameworks, such as Fabric, NeoForge and Quilt</li>
      <li>Easily install and update mods and packs from Modrinth, Curseforge and more</li>
      <li>Control your Java settings, and enable Mangohud or Gamemode with a toggle</li>
      <li>Manage worlds and resource packs from the launcher</li>
      <li>See console, logs and other details easily through a dashboard</li>
      <li>Kill Minecraft in case of a crash/freeze</li>
      <li>Isolate Minecraft instances to keep everything clean</li>
      <li>Customize the launcher with themes, GIF-cats, and more</li>
    </ul>
  </description>
